{
  "manifest_version": 3,
  "name": "Auto Scraper",
  "version": "1.6",
  "description": "Extracts vehicle data from iaai.com and copart.com and copies it as TSV for Google Sheets.",
  "permissions": [
    "scripting",
    "clipboardWrite",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/parsers/*.js"
      ],
      "matches": [
        "*://*.iaai.com/*",
        "*://*.copart.com/*"
      ]
    }
  ]
}
